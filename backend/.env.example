# Database Connection URL (Defaults to local SQLite if omitted)
DATABASE_URL=sqlite:///./stratiq.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stratiq

# AI / LLM Configuration (Optional - platform includes intelligent offline heuristic engine fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server Port & Host
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
